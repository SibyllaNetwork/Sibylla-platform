# Endpoint del proxy ASP.NET Core (Portal/SibyllaApiProxy/).
REACT_APP_API_URL=http://localhost:5289

# Codice applicazione passato al proxy nel signin.
REACT_APP_APP_CODE=sibylla-platform

# 1 = bypassa la login con utente fittizio (solo dev). Lascia vuoto in produzione.
REACT_APP_BYPASS_AUTH=

# App Op! (Op.Api): indirizzo del backend dell'app Op! e, solo in sviluppo, la chiave di
# amministrazione (Amministrazione:ChiaveSviluppo di Op.Api). In produzione vale il token Sibylla.
REACT_APP_OP_API_URL=http://localhost:5235
REACT_APP_OP_ADMIN_KEY=
